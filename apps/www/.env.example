# Set this in production so Open Graph image and canonical URLs are absolute.
# Example: VITE_SITE_URL=https://assetwell.example
VITE_SITE_URL=

# Server-only download analytics (Vercel server environment variables).
# Leave POSTHOG_PROJECT_KEY empty to disable download analytics.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
